{
  "name": "get-better-app",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @get-better/server run dev",
    "dev:web": "pnpm --filter @get-better/web run dev",
    "build": "pnpm --filter @get-better/shared run build && pnpm -r --parallel run build",
    "build:shared": "pnpm --filter @get-better/shared run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @get-better/server run db:generate",
    "db:migrate": "pnpm --filter @get-better/server run db:migrate",
    "db:push": "pnpm --filter @get-better/server run db:push",
    "db:studio": "pnpm --filter @get-better/server run db:studio"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild"
    ]
  }
}
